# 복사해서 .env 로 쓸 것. .env 는 커밋되지 않는다.

# 없으면 폴백 경로로 동작한다 (데모 중단 방지)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 스프링 백엔드. 호출 방향이 Spring → Python 단방향이라 서버 코드는 이 값을 쓰지 않는다.
# tools/streamlit_app.py(개발용 확인 화면)만 참조하므로 Cloud Run 에는 넣을 필요가 없다.
# 배포 주소: https://back-end-git-145786632792.asia-northeast3.run.app
BACKEND_BASE_URL=http://localhost:8080

# 파서 신뢰도 임계값 - 미만이면 PENDING_REVIEW 유지
CONFIDENCE_THRESHOLD=0.85
