# 복사해서 .env 로 쓸 것. .env 는 커밋되지 않는다.

# 없으면 폴백 경로로 동작한다 (데모 중단 방지)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Gemini 호출 1회의 상한(ms). 안 걸면 SDK 기본값이라 사실상 무제한이고, 과부하(503) 때
# 78초까지 매달린 적이 있다. 스프링 read timeout 이 60초라 그 전에 폴백으로 떨어져야 한다.
# 정상 이미지 추출이 36초 걸린 실측이 있어 그보다는 넉넉해야 한다.
GEMINI_TIMEOUT_MS=40000

# 첫 호출이 이 시간을 넘겨 실패했으면 재시도하지 않는다. 느린 실패에서 재시도까지 하면
# 대기가 두 배가 되어 스프링이 먼저 끊고, 그러면 폴백 응답이 사용자에게 도달하지 못한다.
GEMINI_RETRY_BUDGET_SECONDS=15.0

# 스프링 백엔드. 호출 방향이 Spring → Python 단방향이라 서버 코드는 이 값을 쓰지 않는다.
# tools/streamlit_app.py(개발용 확인 화면)만 참조하므로 Cloud Run 에는 넣을 필요가 없다.
# 배포 주소: https://back-end-git-145786632792.asia-northeast3.run.app
BACKEND_BASE_URL=http://localhost:8080

# 파서 신뢰도 임계값 - 미만이면 PENDING_REVIEW 유지
CONFIDENCE_THRESHOLD=0.85

# 배치 알고리즘 상수 - 팀 확정값 아직 없음. 확정되면 여기 값만 바꾸면 된다.
METERS_PER_CELL=3.0
SECONDS_PER_STEP=1.0
